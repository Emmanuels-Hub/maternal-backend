# ── Maternal Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is git-ignored and never committed.

FLASK_DEBUG=true
FLASK_SECRET_KEY=change-me-in-production

# ── N-ATLaS GGUF model (keep disabled on a laptop unless testing inference) ─
ENABLE_LOCAL_MODEL=false
# Pinned third-party Q4_K_M conversion of NCAIR1/N-ATLaS.
NATLAS_MODEL_ID=tosinamuda/N-ATLaS-GGUF
NATLAS_MODEL_REVISION=af9195261dd163807b31318b9b9d577de5ae3b7e
NATLAS_GGUF_FILENAME=N-ATLaS-GGUF-Q4_K_M.gguf
NATLAS_MODEL_PATH=
NATLAS_CONTEXT_SIZE=4096
# 0 runs on CPU; set to -1 only with a CUDA-enabled llama-cpp-python build.
NATLAS_GPU_LAYERS=0
# For a CUDA build, set NATLAS_GPU_LAYERS=-1 to offload all layers.

# ── N-ATLaS ASR (loads only the requested Hausa/Igbo/Yoruba model) ─────────
ENABLE_ASR_MODEL=false
NATLAS_ASR_DEVICE=auto
NATLAS_ASR_MODEL_ROOT=
# Accept each gated model on Hugging Face, then supply a read token securely.
HF_TOKEN=
MAX_UPLOAD_BYTES=26214400

PORT=5000
